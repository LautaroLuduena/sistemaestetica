# Puerto del servidor
PORT=3000
# Archivo de la base de datos (por defecto ./data/estetica.db)
# DB_FILE=./data/estetica.db
# Usuario administrador inicial (solo se usa la primera vez)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame
# URL pública https (también se puede cargar desde Configuración)
# PUBLIC_URL=https://turnos.miestetica.com.ar
